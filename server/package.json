{
  "name": "codebuddy-server",
  "version": "1.0.0",
  "description": "CodeBuddy Backend API & Real-time Server",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node scripts/seedData.js",
    "validate:leetcode": "node scripts/importLeetCodeProblems.js --validate-only",
    "import:leetcode": "node scripts/importLeetCodeProblems.js",
    "select:leetcode500": "node ../data/scripts/generate500Curriculum.js",
    "validate:leetcode500": "node ../data/scripts/generate500Curriculum.js",
    "import:leetcode500": "node scripts/importLeetCodeProblems.js",
    "company:import": "node scripts/importCompanyProblems.js",
    "test": "node scripts/runTests.js"
  },
  "dependencies": {
    "@google/generative-ai": "^0.11.0",
    "axios": "^1.6.8",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.3.1",
    "socket.io": "^4.7.5",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.0"
  }
}
